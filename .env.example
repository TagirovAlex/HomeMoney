# HomeMoney Configuration
# Скопируйте в .env и заполните свои значения

# Flask (false = production, true = разработка)
HM_DEBUG=false

# База данных (по умолчанию SQLite)
HM_DATABASE_URL=sqlite:///./home_money.db

# JWT секрет (минимум 32 символа)
# ⚠️ ОБЯЗАТЕЛЬНО замените на случайную строку 32+ символов!
# Никогда не используйте значение по умолчанию в production!
HM_SECRET_KEY=change-me-to-random-secret-32-bytes!!

# Telegram Bot (оставьте пустым, если бот не используется)
HM_BOT_TOKEN=

# SOCKS5 прокси для Telegram Bot (отдельные поля; оставьте пустыми, если не нужен)
HM_BOT_PROXY_HOST=
HM_BOT_PROXY_PORT=1080
HM_BOT_PROXY_USERNAME=
HM_BOT_PROXY_PASSWORD=

# Telegram ID пользователей, которым разрешено писать боту (через запятую)
# Оставьте пустым, чтобы разрешить всем
HM_BOT_ALLOWED_USERS=
